{
	"name": "@bus-tracker/gtfsrt-tcar-2",
	"description": "GTFS-RT data producer for TCAR (Rouen, France)",
	"version": "0.1.0",
	"author": "Kevin BIOJOUT <biojoutk1106@gmail.com>",
	"license": "MIT",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file .env src/index.ts",
		"dev:web": "pnpm --filter ./web dev",
		"build": "tsc && pnpm --filter ./web build",
		"build:graph": "tsx src/tools/build-road-graph.ts",
		"start": "node dist/index.js",
		"check": "biome check",
		"check:fix": "biome check --fix"
	},
	"packageManager": "pnpm@12.18.0",
	"dependencies": {
		"@anthropic-ai/sdk": "^1.8.0",
		"@hono/node-server": "^2.1.7",
		"entities": "^9.0.0",
		"fflate": "^0.8.3",
		"gtfs-realtime-bindings": "^2.2.0",
		"hono": "^4.13.18",
		"hono-rate-limiter": "^0.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
